# PostgreSQL 연결 문자열 (로컬 또는 Supabase의 Connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chargesafe

# JWT 서명 키 — 반드시 임의의 긴 문자열로 변경
JWT_SECRET=change-me-to-a-long-random-string

# 프론트엔드(monitoringApi.js)의 기본 API 주소와 맞춘 포트
PORT=8000

# CORS 허용 출처 (쉼표 구분). 프론트엔드가 다른 주소에서 API를 호출할 때 필요합니다.
# 미설정 시 localhost:5173 / 4173 / 3000 / 8000 만 허용합니다.
# 배포 시에는 실제 프론트엔드 도메인을 넣으세요.
# CORS_ORIGINS=http://localhost:5173,https://chargesafe.example.com

# FCM 푸시 알림 (선택) — Firebase 콘솔에서 받은 서비스 계정 키 파일 경로
# 미설정 시 알림은 DB에만 기록됩니다. 설정 방법은 README의 "푸시 알림 설정" 참고
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# 위험 판단 임계값 (미설정 시 코드의 기본값 사용 — 12V 계열 배터리 기준)
# TEMP_DANGER=50
# TEMP_WARNING=45
# TEMP_CAUTION=40
# CURRENT_MAX_A=4
# VOLTAGE_MAX_V=14.5
# 충전량 추정용 전압 범위 (0% / 100%)
# SOC_MIN_VOLT=11.8
# SOC_MAX_VOLT=12.75
# 온도 상승 속도 (℃/분) — 이 값 이상이면 주의 단계
# TEMP_RISE_PER_MIN=2
# 기기 펌웨어 최신 버전 (다르면 "업데이트 필요" 표시)
# LATEST_FIRMWARE_VERSION=1.0.0
# 펌웨어 내려받을 주소 — 센서 수신 응답의 firmware.url 로 기기에 전달됩니다
# FIRMWARE_UPDATE_URL=https://example.com/firmware/chargesafe-1.0.0.bin
