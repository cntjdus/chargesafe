# PostgreSQL 연결 문자열 (로컬 또는 Supabase의 Connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chargesafe

# JWT 서명 키 — 반드시 임의의 긴 문자열로 변경
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000

# FCM 푸시 알림 (선택) — Firebase 콘솔에서 받은 서비스 계정 키 파일 경로
# 미설정 시 알림은 DB에만 기록됩니다. 설정 방법은 README의 "푸시 알림 설정" 참고
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# 위험 판단 임계값 (미설정 시 코드의 기본값 사용)
# TEMP_DANGER=60
# TEMP_WARNING=50
# TEMP_CAUTION=45
# TEMP_RISE_PER_MIN=2
# GAS_DANGER_PPM=300
# CURRENT_MAX_A=5
# VOLTAGE_MAX_V=29.4
