/*
 * secrets.h.example — 비밀값 템플릿
 * ---------------------------------------------------------------
 * 사용법
 *   1) 이 파일을 같은 폴더에 secrets.h 라는 이름으로 복사한다
 *   2) 아래 세 값을 본인 환경에 맞게 채운다
 *
 * secrets.h 는 .gitignore 로 제외되므로 저장소에 올라가지 않는다.
 * 실제 값을 이 파일(.example)에 적지 말 것 — 이 파일은 저장소에 올라간다.
 */
#pragma once

// ESP32 는 2.4GHz 만 지원한다. 5GHz 전용 공유기에는 접속되지 않는다.
#define SECRET_WIFI_SSID      "와이파이_이름"
#define SECRET_WIFI_PASSWORD  "와이파이_비밀번호"

// 기기 등록 시 딱 한 번 발급된 API 키 (csk_ 로 시작)
#define SECRET_API_KEY        "csk_대시보드에서_발급받은_키"
